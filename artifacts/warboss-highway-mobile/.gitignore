# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
ios/
android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Higgsfield generation source images for assets/3d/ — the app only loads the
# .glb meshes at runtime. Kept on disk locally (per request) but not
# committed: ~119MB of 2K concept art with zero runtime purpose would bloat
# the repo permanently. The .glb outputs themselves ARE tracked.
assets/3d/**/concept-images/
assets/3d/legacy-junkyard-concepts/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

.env

# Dev-only Expo-web verification asset (copied from node_modules/canvaskit-wasm
# by hand, ~8MB) — this app targets iOS; web is only used as a local render-
# pipeline check on machines without an iOS simulator. Never commit this.
public/canvaskit.wasm
