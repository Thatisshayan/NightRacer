# Postgres connection string for the API server + Drizzle ORM (lib/db).
# Never commit a real .env — this file is the template only.
# Provisioned on Neon (https://console.neon.tech) — pooled connection string,
# used for local dev, staging, and prod alike (no local/Docker Postgres needed).
DATABASE_URL=postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
